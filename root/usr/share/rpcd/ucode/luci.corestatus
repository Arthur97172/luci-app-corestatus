
'use strict';

import { chdir, lsdir, popen, readfile, readlink, realpath, rename, stat, writefile } from 'fs';

const sysHwmon   = '/sys/class/hwmon';
const sysThermal = '/sys/class/thermal';

const tempProbe       = '/usr/libexec/corestatus-temp-probe';
const tempProbeHeader = 'corestatus-temp-probe 1';
const tempState       = '/tmp/luci.corestatus.tempchannels';
const tempProbeGrace  = 2;
const tempProbeRetry  = 60;

function readFile(path) {
	let r = readfile(path);
	return r && trim(r);
}

function isHwmonTempPath(path) {
	return match(path, /^\/sys\/class\/hwmon\/hwmon[0-9]+\/temp[0-9]+_input$/);
}

// All hwmon temperature inputs currently present, without reading any of them.
function hwmonTempPaths() {
	let paths = [];
	if(stat(sysHwmon)?.type == 'directory') {
		for(let item in lsdir(sysHwmon)) {
			if(!match(item, /^hwmon[0-9]+$/)) {
				continue;
			}
			let dirPath = sprintf('%s/%s', sysHwmon, item);
			if(stat(dirPath)?.type != 'directory') {
				continue;
			}
			for(let source in lsdir(dirPath)) {
				if(match(source, /^temp[0-9]+_input$/)) {
					push(paths, sprintf('%s/%s', dirPath, source));
				}
			}
		}
	}
	return paths;
}

// The healthy channels from the last probe, or null when no probe has run.
// An empty list is a valid result: every channel was blocked.
function readTempChannels() {
	if(stat(tempState)?.type != 'file') {
		return null;
	}
	let data = readfile(tempState);
	if(data == null) {
		return null;
	}
	let channels = [];
	for(let line in split(data, '\n')) {
		line = trim(line);
		if(isHwmonTempPath(line)) {
			push(channels, line);
		}
	}
	return channels;
}

function writeTempChannels(channels) {
	let data = length(channels) > 0 ? join('\n', channels) + '\n' : '';
	let tmp  = tempState + '.new';
	if(writefile(tmp, data) == null) {
		return false;
	}
	return rename(tmp, tempState);
}

/*
 * Read every channel once, in parallel, and keep the ones that answered
 * within tempProbeGrace seconds. See root/usr/libexec/corestatus-temp-probe
 * for why a channel that blocks must never be read a second time.
 *
 * Returns the healthy paths, or null if the helper could not be run (the
 * caller then falls back to reading everything, as older versions did).
 */
function probeTempChannels(paths) {
	let args = [];
	for(let path in paths) {
		if(isHwmonTempPath(path)) {
			push(args, path);
		}
	}
	if(length(args) == 0) {
		writeTempChannels([]);
		return [];
	}
	if(stat(tempProbe)?.type != 'file') {
		return null;
	}
	let out;
	let status;
	try {
		let proc = popen(sprintf('%s %d %s', tempProbe, tempProbeGrace, join(' ', args)), 'r');
		if(proc == null) {
			return null;
		}
		out    = proc.read('all');
		status = proc.close();
	}
	catch (e) {
		return null;
	}
	if(status != 0 || out == null) {
		return null;
	}
	let lines = split(out, '\n');
	if(length(lines) == 0 || trim(lines[0]) != tempProbeHeader) {
		return null;
	}
	let channels = [];
	for(let i = 1; i < length(lines); i++) {
		let line = trim(lines[i]);
		if(isHwmonTempPath(line)) {
			push(channels, line);
		}
	}
	writeTempChannels(channels);
	return channels;
}

// Forget a channel that failed to answer, so later polls do not read it again.
function dropTempChannel(path) {
	let channels = readTempChannels();
	if(channels == null) {
		return;
	}
	let kept  = [];
	let found = false;
	for(let channel in channels) {
		if(channel == path) {
			found = true;
		}
		else {
			push(kept, channel);
		}
	}
	if(found) {
		writeTempChannels(kept);
	}
}

/*
 * Return the set of hwmon channels that may be read, or null when no filtering
 * is possible (no probe helper): callers then read every channel.
 *
 * A probe runs when there is no state yet, and - on sensor discovery only -
 * when a current channel is missing from the state and the state is at least
 * tempProbeRetry seconds old. Polling (getTempData) never re-probes by itself:
 * a channel that blocks in the driver would stall the radio on every probe.
 */
function allowedTempPaths(paths, mayProbe) {
	let channels = readTempChannels();

	if(channels == null) {
		channels = probeTempChannels(paths);
		if(channels == null) {
			return null;
		}
	}
	else if(mayProbe) {
		let known    = {};
		let missing  = false;
		for(let channel in channels) {
			known[channel] = true;
		}
		for(let path in paths) {
			if(!exists(known, path)) {
				missing = true;
				break;
			}
		}
		let s   = stat(tempState);
		let age = s ? time() - int(s.mtime) : null;
		if(missing && (age == null || age >= tempProbeRetry)) {
			channels = probeTempChannels(paths);
			if(channels == null) {
				return null;
			}
		}
	}

	let allowed = {};
	channels = channels || [];
	for(let channel in channels) {
		allowed[channel] = true;
	}
	return allowed;
}

function findTPoints(thermalDirPath) {
	let tPoints = {};
	if(stat(thermalDirPath)?.type == 'directory') {
		for(let tItem in lsdir(thermalDirPath)) {
			if(match(tItem, /^trip_point_[0-9]+_type$/)) {
				let pTypePath = sprintf('%s/%s', thermalDirPath, tItem);
				let m         = match(tItem, /[0-9]+/);
				let pNumber   = m && m[0];
				let pType     = readFile(pTypePath);
				let pTemp     = readFile(replace(pTypePath, /_type$/, '_temp'));
				if(pNumber && pType && pTemp) {
					tPoints[pNumber] = { type: pType, temp: int(pTemp) };
				}
			}
		}
	}
	return (length(tPoints) > 0) ? tPoints : null;
}

function getHwmonData(tDevPath, tempData) {
	let hwmon = [];
	// Decide which channels answer before reading any of them; see
	// allowedTempPaths().
	let allowed = allowedTempPaths(hwmonTempPaths(), true);
	if(stat(sysHwmon)?.type == 'directory') {
		for(let item in lsdir(sysHwmon)) {
			if(match(item, /^hwmon[0-9]+$/)) {
				let hwmonDirPath  = sprintf('%s/%s', sysHwmon, item);
				let deviceDirPath = readlink(sprintf('%s/device', hwmonDirPath));
				if(deviceDirPath) {
					chdir(hwmonDirPath);
					let path = realpath(deviceDirPath);
					if(path) {
						tDevPath[path] = true;
					}
				}
				if(stat(hwmonDirPath)?.type == 'directory') {
					let m       = match(item, /[0-9]+/);
					let dNumber = m && m[0];
					let title   = readFile(hwmonDirPath + '/name');
					let sources = [];
					for(let source in lsdir(hwmonDirPath)) {
						if(match(source, /^temp[0-9]+_input$/)) {
							let tPoints        = {};
							let m              = match(source, /[0-9]+/);
							let sNumber        = m && m[0];
							let sourceFilePath = sprintf('%s/%s', hwmonDirPath, source);
							// Only channels that answered the probe are read. A
							// read blocked in the driver cannot be cancelled, so
							// issuing it again would park rpcd and the radio too.
							if(allowed != null && !exists(allowed, sourceFilePath)) {
								continue;
							}
							let fault          = readFile(sprintf(
								"%s/%s", hwmonDirPath, replace(source, /_input$/, '_fault')));
							// a faulted input (e.g. an unconnected remote diode on nct7802)
							// reads as a sentinel such as 127.875 °C and is not a temperature
							if(fault && int(fault) != 0) {
								continue;
							}
							let temp           = readFile(sourceFilePath);
							if(sNumber && temp) {
								tempData[sourceFilePath] = int(temp);
								let label = readFile(sprintf(
									"%s/%s", hwmonDirPath, replace(source, /_input$/, '_label')));
								let tPointEmer = readFile(sprintf(
									"%s/%s", hwmonDirPath, replace(source, /_input$/, '_emergency')));
								if(tPointEmer) {
									tPoints['0'] = { type: 'emergency', temp: int(tPointEmer) };
								}
								let tPointCrit = readFile(sprintf(
									"%s/%s", hwmonDirPath, replace(source, /_input$/, '_crit')));
								if(tPointCrit) {
									tPoints['1'] = { type: 'critical', temp: int(tPointCrit) };
								}
								let tPointMax = readFile(sprintf(
									"%s/%s", hwmonDirPath, replace(source, /_input$/, '_max')));
								if(tPointMax) {
									tPoints['2'] = { type: 'max', temp: int(tPointMax) };
								}
								if(deviceDirPath && length(tPoints) == 0) {
									tPoints = (findTPoints(deviceDirPath) || tPoints);
								}
								let sDict = {
									number: int(sNumber),
									item  : source,
									path  : sourceFilePath,
									temp  : int(temp),
								};
								if(label) {
									sDict['label'] = label;
								};
								if(length(tPoints) > 0) {
									sDict['tpoints'] = tPoints;
								}
								push(sources, sDict);
							}
							else if(sNumber) {
								// The channel stopped answering: drop it so the
								// next poll does not read it again.
								dropTempChannel(sourceFilePath);
							}
						}
					}
					if(dNumber && length(sources) > 0) {
						let d = {
							number : int(dNumber),
							item   : item,
							sources: sources,
						};
						if(title) {
							d['title'] = title;
						}
						push(hwmon, d);
					}
				}
			}
		}
	}
	return hwmon;
}

function getThermalData(tDevPath, tempData) {
	let thermal = [];
	if(stat(sysThermal)?.type == 'directory') {
		chdir(sysThermal);
		for(let item in lsdir(sysThermal)) {
			if(match(item, /^thermal_zone[0-9]+$/)) {
				let thermalDirPath = sprintf('%s/%s', sysThermal, item);
				let deviceDirPath  = readlink(thermalDirPath);
				if(deviceDirPath && exists(tDevPath, realpath(deviceDirPath))) {
					continue;
				}
				let m            = match(item, /[0-9]+/);
				let number       = m && m[0];
				let tempFilePath = thermalDirPath + '/temp';
				let temp         = readFile(tempFilePath);
				if(number && temp) {
					tempData[tempFilePath] = int(temp);
					let title   = readFile(thermalDirPath + '/type');
					let tPoints = findTPoints(thermalDirPath);
					let sDict = {
						number: 0,
						path  : tempFilePath,
						temp  : int(temp),
					};
					if(tPoints && length(tPoints) > 0) {
						sDict['tpoints'] = tPoints;
					}
					let tDict = {
						number : int(number),
						item   : item,
						sources: [ sDict ],
					};
					if(title) {
						tDict['title'] = title;
					}
					push(thermal, tDict);
				}
			}
		}
	}
	return thermal;
}

function getSensors() {
	const tDevPath = {};
	const tempData = {};
	let sensors    = {};
	let hwmon      = getHwmonData(tDevPath, tempData);
	if(length(hwmon) > 0) {
		sensors['0'] = hwmon;
	}
	let thermal = getThermalData(tDevPath, tempData);
	if(length(thermal) > 0) {
		sensors['1'] = thermal;
	}
	return { sensors: sensors, temp: tempData };
}

const methods = {
	getSensors: {
		call: getSensors
	},

	getTempData: {
		args: { tpaths: [] },
		call: function(request) {
			const tpaths = request.args?.tpaths;
			let tData    = {};
			if(tpaths && length(tpaths) > 0) {
				// Polling never probes: it only reads the channels the last
				// probe accepted. See allowedTempPaths().
				let allowed = allowedTempPaths(hwmonTempPaths(), false);
				for(let i in tpaths) {
					let isHwmon = isHwmonTempPath(i);
					if(isHwmon && allowed != null && !exists(allowed, i)) {
						tData[i] = null;
						continue;
					}
					let faultPath = replace(i, /_input$/, '_fault');
					if(match(faultPath, /_fault$/)) {
						let fault = readFile(faultPath);
						if(fault && int(fault) != 0) {
							tData[i] = null;
							continue;
						}
					}
					let t = readFile(i);
					if(t) {
						tData[i] = int(t);
					}
					else {
						tData[i] = null;
						if(isHwmon) {
							// A channel that no longer answers must not be
							// read again on the next poll.
							dropTempChannel(i);
						}
					}
				}
			}
			return { temp: tData };
		}
	},

	/*
	 * For compatibility with <= v0.6.
	 * Will be removed in the future.
	 */
	getTempStatus: {
		call: function() { return getSensors().sensors }
	}
};

return { 'luci.corestatus': methods };
